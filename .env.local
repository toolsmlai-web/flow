# Supabase Configuration (from Vercel integration)
# Your Supabase credentials are automatically set via Vercel integration
# These are read from environment variables:
# - NEXT_PUBLIC_SUPABASE_URL
# - NEXT_PUBLIC_SUPABASE_ANON_KEY
# - SUPABASE_SERVICE_ROLE_KEY

# Upstash Redis (for rate limiting - optional, recommended)
# Get these from https://console.upstash.com
# UPSTASH_REDIS_REST_URL=https://your-project.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Email Service - Resend (recommended)
# Get API key from https://resend.com
# Format: re_XXXXXXXXX
RESEND_API_KEY=

# CORS Configuration (allow your domain)
ALLOWED_ORIGINS=https://checkflow.ai,https://www.checkflow.ai,http://localhost:3000

# Sentry Error Tracking (optional)
# Get DSN from https://sentry.io
# SENTRY_DSN=

# Application Environment
NODE_ENV=development

# Database (Note: Uses Supabase from Vercel integration)
# The following are automatically provided:
# POSTGRES_URL=postgresql://...
# POSTGRES_PRISMA_URL=postgresql://...
# POSTGRES_URL_NON_POOLING=postgresql://...
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=...
# POSTGRES_HOST=...
# POSTGRES_DATABASE=postgres
